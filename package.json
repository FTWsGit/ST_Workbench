{
  "name": "ST_Workbench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src && stylelint src/**/*.css",
    "lint-fix": "eslint src --fix && stylelint src/**/*.css --fix",
    "format": "prettier --write src",
    "test": "vitest run",
    "docs:get_always": "node .agents/skills/ws-doc-read/scripts/print_always.mjs",
    "docs:list": "node .agents/skills/ws-doc-read/scripts/list_docs.mjs",
    "docs:create": "node .agents/skills/ws-doc-read/scripts/create_docs.mjs"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "prismjs": "^1.30.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.0.7"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "vue-demi@0.14.10": true,
    "unrs-resolver@1.12.2": true
  }
}
