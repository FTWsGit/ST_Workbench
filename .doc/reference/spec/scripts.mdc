# scripts

## ScriptTree（+Script/ScriptButton/ScriptFolder）

```ts
// 脚本树：Tavern Helper 面板里的脚本结构；folder 是顶层组织单元，不递归嵌套
type ScriptTree = Script | ScriptFolder;

type Script = {
  type: 'script';
  enabled: boolean;
  name: string;
  id: string;
  content: string;        // 脚本源码
  info: string;
  button: { enabled: boolean; buttons: ScriptButton[] };
  data: Record<string, any>;  // 扩展自定义数据
  export_with: { data: boolean; button: boolean };   // 是否随宿主（角色卡/预设）导出（数据/按钮分别控制）
  // 分组字段 _gid/_gname/_gcollapsed/_genabled/_gidx 经 [k: string]: any 塞进来，
  // 跟 RegexScript 同模式；顶层 folder 不带分组字段
  [k: string]: any;
};

// 单个按钮：字段名跟上游 Js-Slash-Runner 的 zod schema 一致
type ScriptButton = {
  name: string;       // 按钮显示文字，兼作事件 id 的 hash 种子
  visible: boolean;   // false 时仍留在 buttons[] 里，只是不渲染到工具栏
  [k: string]: any;
};

type ScriptFolder = {
  type: 'folder';
  enabled: boolean;
  name: string;
  id: string;
  icon: string;
  color: string;
  scripts: Script[];      // 直接挂树顶层的子脚本，不递归
};
```

## RegexScript

```ts
// 正则脚本：预设/角色卡共用，随宿主一起存取（不需单独 IO）
// 数字枚举（placement/substituteRegex）与 ST 原生数字在 api/scriptConvert.ts 边界互转
type RegexScript = {
  id: string;
  name: string;
  findRegex: string;
  replaceString: string;
  trimStrings: string[];
  placement: RegexPlacement[];        // 字符串枚举：user_input/ai_output/quick_command/world_info/reasoning
  enabled: boolean;                    // ST 原生是 disabled，取反转换在 api 边界完成
  scope: RegexScope[];                // 'displayOnly' | 'promptOnly' | 'both' → 映射回原生 markdownOnly/promptOnly 两个 bool
  runOnEdit: boolean;
  substituteRegex: 'none' | 'raw' | 'escaped';  // 对应原生 0/1/2
  depth: { minDepth: number | null; maxDepth: number | null };
  [k: string]: any;             // 分组字段 _gid/_gname/_gcollapsed/_genabled/_gidx 塞进来
};
```
