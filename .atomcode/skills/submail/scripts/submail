#!/usr/bin/env bash
# submail 短入口 —— 转发到 ../src/cli.py（scripts/ 与 src/ 平级，子 agent 用 bash 调用）。
# 用法（装了 PATH 后可直接）: submail send --to w2 --me w1 --body "你好"
# 用法（没装 PATH 时）: bash <SKILL_SCRIPTS>/submail send --to w2 --me w1 --body "你好"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec python "$SCRIPT_DIR/../src/cli.py" "$@"
